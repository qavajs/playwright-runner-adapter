{
  "name": "@qavajs/playwright-runner-adapter",
  "version": "2.4.0",
  "description": "adapter for playwright test runner",
  "main": "adapter/index.js",
  "types": "adapter/index.d.ts",
  "exports": {
    ".": {
      "types": "./adapter/index.d.ts",
      "require": "./adapter/index.js",
      "import": "./adapter/index.js",
      "default": "./adapter/index.js"
    },
    "./js": {
      "types": "./adapter/js/index.d.ts",
      "require": "./adapter/js/index.js",
      "import": "./adapter/js/index.js",
      "default": "./adapter/js/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "adapter/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsc --project tsconfig.js.json",
    "test:ui": "playwright test --config test/playwright.config.ts --ui",
    "test:e2e": "playwright test --config test/playwright.config.ts --project parallel --project serial --project unit"
  },
  "author": "Alexandr Galichenko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qavajs/playwright-runner-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/qavajs/playwright-runner-adapter/issues"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/tag-expressions": "^11.0.1",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@qavajs/playwright-console-reporter": "^0.1.0",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "test",
    "automation",
    "testing",
    "qa",
    "quality-assurance",
    "test-framework",
    "test-runner",
    "test-automation",
    "e2e",
    "end-to-end",
    "ui-testing",
    "integration-testing",
    "acceptance-testing",
    "functional-testing",
    "browser-testing",
    "mobile-testing",
    "cross-browser",
    "bdd",
    "gherkin",
    "assertions",
    "continuous-delivery",
    "automation-framework",
    "playwright"
  ]
}
